# SIEM to SOAR - Active Defense Node Environment Template
# ------------------------------------------------------------------
# Rename this file to '.env' and fill in your keys.

# Required: Used to authenticate the SOAR to the Webhook
# If left blank, the script will auto-generate a secure key on first run.
WEBHOOK_API_KEY=

# Optional (Phase 5): Required if you are tunneling your localhost to the public internet
NGROK_AUTH_TOKEN=your_ngrok_token_here

# Optional (Phase 6): Threat Intel API key to prevent blocking legitimate IPs
VIRUSTOTAL_API_KEY=your_virustotal_token_here

# Optional (Phase 7): Team Alert integrations. Fill in whichever platforms you use.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
