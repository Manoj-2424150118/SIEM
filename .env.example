# SIEM to SOAR - Active Defense Node Environment Template
# ------------------------------------------------------------------
# Rename this file to '.env' and fill in your keys.

# Required: Used to authenticate the SOAR to the Webhook
# If left blank, the script will auto-generate a secure key on first run.
WEBHOOK_API_KEY=

# Optional (Phase 5): Required if you are tunneling your localhost to the public internet
NGROK_AUTH_TOKEN=your_ngrok_token_here

# Optional (Phase 6): Threat Intel API key to prevent blocking legitimate IPs
VIRUSTOTAL_API_KEY=your_virustotal_token_here

# Optional (Phase 8): Incident ledger — the node's persistent memory.
# SIEM_INCIDENTS_PATH: where decisions are recorded (default: incidents.jsonl
# next to webhook_listener.py). SIEM_DEDUPE_WINDOW_HOURS: repeat webhooks for
# an IP blocked within this window are answered from the ledger alone
# (default: 24) — no VirusTotal call, no firewall work, no duplicate alert.
# SIEM_INCIDENTS_PATH=/var/log/siem/incidents.jsonl
# SIEM_DEDUPE_WINDOW_HOURS=24

# Optional (Phase 7): Team Alert integrations. Fill in whichever platforms you use.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
